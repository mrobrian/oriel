<Page x:Class="Windower.UI.Views.PackagesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="clr-namespace:Windower.UI"
      mc:Ignorable="d" d:DesignWidth="368" d:DesignHeight="560"
      Style="{StaticResource Page}"
      ui:TransitionControl.EnterTransition="SlideDown"
      ui:TransitionControl.ExitTransition="SlideUp">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>
        <Style x:Key="RowButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{StaticResource Strings.Packages}" FontSize="28" FontWeight="Light" Margin="12,8,12,4"/>

        <TextBox Grid.Row="1" Margin="12,4" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="{StaticResource Strings.SearchPackages}" FontSize="15"/>

        <CheckBox Grid.Row="2" Margin="12,4,12,0" Content="{StaticResource Strings.ShowLibraries}"
                  IsChecked="{Binding ShowLibraries}" ToolTip="{StaticResource Strings.ShowLibrariesToolTip}"/>

        <TextBlock Grid.Row="3" Margin="12,6,12,2" TextWrapping="Wrap" FontSize="12" LineHeight="16"
                   Foreground="{StaticResource BaseMediumHigh}" Text="{Binding Status}"
                   Visibility="{Binding HasStatus, Converter={StaticResource Visible}}"/>

        <ListBox Grid.Row="4" Margin="0,6,0,0" ItemsSource="{Binding PackagesView}" Background="{x:Null}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Focusable="False"
                 VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <Border x:Name="Row" Background="Transparent" Padding="12,8,12,10">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource ListLow}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12"
                                   Foreground="{StaticResource BaseMedium}" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}" TextWrapping="Wrap"
                                   FontSize="12" LineHeight="16" Margin="0,2,0,0" Foreground="{StaticResource BaseMedium}"
                                   Visibility="{Binding HasDescription, Converter={StaticResource Visible}}"/>

                        <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0" VerticalAlignment="Center">
                            <Button Style="{StaticResource RowButton}" Content="{StaticResource Strings.Install}"
                                    Command="{Binding DataContext.Install, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding IsNotInstalled, Converter={StaticResource Visible}}"/>
                            <Button Style="{StaticResource RowButton}" Content="{StaticResource Strings.Update}"
                                    Command="{Binding DataContext.Install, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding HasUpdate, Converter={StaticResource Visible}}"/>
                            <Button Style="{StaticResource RowButton}" Content="{StaticResource Strings.Remove}"
                                    Command="{Binding DataContext.Remove, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding CanRemove, Converter={StaticResource Visible}}"/>
                            <CheckBox Content="{StaticResource Strings.LoadAtStartup}" IsChecked="{Binding LoadAtStartup}"
                                      VerticalAlignment="Center" Margin="4,0,0,0"
                                      ToolTip="{StaticResource Strings.LoadAtStartupToolTip}"
                                      Visibility="{Binding CanLoadAtStartup, Converter={StaticResource Visible}}"/>
                        </WrapPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="5" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Content="{StaticResource Strings.UpdateAll}" Command="{Binding UpdateAll}"/>
            <Button Grid.Column="2" Content="{StaticResource Strings.Close}" Command="{Binding Close}"/>
        </Grid>
    </Grid>
</Page>
